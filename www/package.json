{
	"name": "berm-www",
	"private": true,
	"type": "module",
	"scripts": {
		"book": "cd .. && mdbook build docs --dest-dir www/static/book",
		"dev": "bun run ensure && vite dev",
		"ensure": "test -d static/book || bun run book",
		"build": "bun run book && vite build",
		"preview": "vite preview",
		"deploy": "bun run build && wrangler pages deploy build --project-name=berm --branch=main"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.20.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"svelte": "^5.20.0",
		"vite": "^6.0.0",
		"wrangler": "^4.125.0"
	},
	"dependencies": {
		"lucide-static": "^1.31.0",
		"simple-icons": "^16.28.0"
	}
}
